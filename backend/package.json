{
  "type": "commonjs",
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:dev:deploy": "prisma migrate deploy",
    "db:dev:up": "docker-compose up dev-db -d",
    "db:dev:rm": "docker-compose rm dev-db -f -s -v",
    "db:dev:seed": "dotenv -e .env -- ts-node prisma/seed.ts",
    "db:dev:restart": "npm run db:dev:rm && npm run db:dev:up && sleep 1 && npm run prisma:dev:deploy",
    "seed": "dotenv -e .env -- ts-node prisma/seed.ts",
    "seed:all": "dotenv -e .env -- ts-node prisma/seed-all.ts",
    "seed:rbac": "dotenv -e .env -- ts-node prisma/seed-only-rbac.ts",
    "make-admin": "dotenv -e .env -- ts-node prisma/make-admin.ts",
    "seed:clean": "dotenv -e .env -- ts-node prisma/clean-db.ts",
    "seed:users": "dotenv -e .env -- ts-node prisma/seed-only-users.ts",
    "seed:tags": "dotenv -e .env -- ts-node prisma/seed-only-tags.ts",
    "seed:decks": "dotenv -e .env -- ts-node prisma/seed-only-decks-flashcards.ts",
    "seed:reviews": "dotenv -e .env -- ts-node prisma/seed-only-reviews.ts",
    "seed:feedbacks": "dotenv -e .env -- ts-node prisma/seed-only-feedbacks.ts",
    "prisma:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:up": "docker-compose up test-db -d",
    "db:test:rm": "docker-compose rm test-db -f -s -v",
    "db:test:restart": "npm run db:test:rm && npm run db:test:up && sleep 1 && npm run prisma:test:deploy",
    "vector-db:dev:up": "docker-compose up dev-vector-db -d",
    "vector-db:dev:down": "docker-compose rm dev-vector-db -f -s -v",
    "vector-db:dev:restart": "npm run vector-db:dev:down && npm run vector-db:dev:up",
    "vector-db:test:up": "docker-compose up test-vector-db -d",
    "vector-db:test:down": "docker-compose rm test-vector-db -f -s -v",
    "vector-db:test:restart": "npm run vector-db:test:down && npm run vector-db:test:up",
    "minio:dev:up": "docker-compose up dev-minio -d",
    "minio:dev:down": "docker-compose rm dev-minio -f -s -v",
    "minio:dev:restart": "npm run minio:dev:down && npm run minio:dev:up",
    "minio:test:up": "docker-compose up test-minio -d",
    "minio:test:down": "docker-compose rm test-minio -f -s -v",
    "minio:test:restart": "npm run minio:test:down && npm run minio:test:up",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "dev": "npm run db:dev:restart && npm run vector-db:dev:restart && npm run minio:dev:restart && npm run start:dev",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "npm run db:test:restart && npm run vector-db:test:restart && npm run minio:test:restart && sleep 1",
    "test:e2e": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --no-cache --runInBand --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@adminjs/nestjs": "^7.0.0",
    "@adminjs/prisma": "^5.0.4",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@huggingface/inference": "^4.13.17",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.47",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.6",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/express-session": "^1.19.0",
    "adminjs": "^7.8.17",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-session": "^1.19.0",
    "langchain": "^1.4.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "crypto": "^1.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "dotenv -e .env -- ts-node prisma/seed.ts"
  }
}
