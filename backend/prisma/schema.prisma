// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  username         String
  email            String   @unique
  avatarKey        String?  @map("avatar_key")
  passwordHash     String   @map("password_hash")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  decks                Deck[]
  educationalResources EducationalResource[]
  chats                Chat[]

  @@map("users")
}

model Deck {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  isPublic    Boolean  @default(false) @map("is_public")
  coverKey    String?  @map("cover_key")
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                 User                      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  flashcards           Flashcard[]
  educationalResources DeckEducationalResource[]

  @@map("decks")
}

enum ReviewRating {
  AGAIN
  BAD
  GOOD
  PERFECT
}

model Flashcard {
  id           Int      @id @default(autoincrement())
  front        String
  back         String
  deckId       Int      @map("deck_id")
  repetitions  Int      @default(0)
  intervalDays Int      @default(0) @map("interval_days")
  easeFactor   Float    @default(2.5) @map("ease_factor")
  dueAt        DateTime @default(now()) @map("due_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deck          Deck            @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  reviewHistory ReviewHistory[]

  @@map("flashcards")
}

model ReviewHistory {
  id          Int          @id @default(autoincrement())
  flashcardId Int          @map("flashcard_id")
  rating      ReviewRating
  reviewedAt  DateTime     @default(now()) @map("reviewed_at")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("review_history")
}

model EducationalResource {
  id               Int      @id @default(autoincrement())
  name             String
  description      String
  fileKey          String   @map("file_key")
  coverKey         String?  @map("cover_key")
  originalFilename String   @map("original_filename")
  userId           Int      @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User                      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  decks DeckEducationalResource[]

  @@map("educational_resources")
}

model DeckEducationalResource {
  deckId                Int @map("deck_id")
  educationalResourceId Int @map("educational_resource_id")

  deck                Deck                @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  educationalResource EducationalResource @relation(fields: [educationalResourceId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([deckId, educationalResourceId])
  @@map("deck_educational_resources")
}

model Chat {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int

  user     User          @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  messages ChatMessage[]

  @@map("chats")
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        Int             @id @default(autoincrement())
  role      ChatMessageRole
  content   String
  citations Json?
  chatId    Int             @map("chat_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt()

  chat Chat @relation(fields: [chatId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}
