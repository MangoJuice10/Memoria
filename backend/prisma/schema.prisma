// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  username         String
  email            String   @unique
  avatarKey        String?  @map("avatar_key")
  passwordHash     String   @map("password_hash")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  userRoles            UserRole[]
  decks                Deck[]
  educationalResources EducationalResource[]
  chats                Chat[]
  feedback             Feedback[]

  @@map("users")
}

model Deck {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  isPublic    Boolean  @default(false) @map("is_public")
  coverKey    String?  @map("cover_key")
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                 User                      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  flashcards           Flashcard[]
  educationalResources DeckEducationalResource[]
  tags                 DeckTag[]
  feedback             Feedback[]

  @@map("decks")
}

model Flashcard {
  id           Int      @id @default(autoincrement())
  front        String
  back         String
  deckId       Int      @map("deck_id")
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  intervalDays Int      @default(0) @map("interval_days")
  easeFactor   Float    @default(2.5) @map("ease_factor")
  dueAt        DateTime @default(now()) @map("due_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deck    Deck     @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  reviews Review[]

  @@map("flashcards")
}

enum ReviewRating {
  AGAIN
  BAD
  GOOD
  PERFECT
}

model Review {
  id              Int          @id @default(autoincrement())
  flashcardId     Int          @map("flashcard_id")
  rating          ReviewRating
  startedAt       DateTime     @map("started_at")
  endedAt         DateTime     @default(now()) @map("ended_at")
  oldIntervalDays Int          @default(0) @map("old_interval_days")
  oldEaseFactor   Float        @default(2.5) @map("old_ease_factor")
  flashcard       Flashcard    @relation(fields: [flashcardId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("reviews")
}

model EducationalResource {
  id               Int      @id @default(autoincrement())
  name             String
  description      String
  fileKey          String   @map("file_key")
  coverKey         String?  @map("cover_key")
  originalFilename String   @map("original_filename")
  userId           Int      @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User                      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  decks DeckEducationalResource[]

  @@map("educational_resources")
}

model DeckEducationalResource {
  deckId                Int @map("deck_id")
  educationalResourceId Int @map("educational_resource_id")

  deck                Deck                @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  educationalResource EducationalResource @relation(fields: [educationalResourceId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([deckId, educationalResourceId])
  @@map("deck_educational_resources")
}

model Chat {
  id        Int      @id @default(autoincrement())
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int

  user     User          @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  messages ChatMessage[]

  @@map("chats")
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        Int             @id @default(autoincrement())
  role      ChatMessageRole
  content   String
  chatId    Int             @map("chat_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt()

  chat Chat @relation(fields: [chatId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  color String

  decks DeckTag[]

  @@map("tags")
}

model DeckTag {
  deckId Int @map("deck_id")
  tagId  Int @map("tag_id")

  deck Deck @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([deckId, tagId])
  @@map("deck_tags")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  content   String
  rating    Int
  deckId    Int      @map("deck_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deck Deck @relation(fields: [deckId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("feedbacks")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  resource    String
  action      String
  scope       String   @default("own")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
